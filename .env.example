# Land Scanner Prototype - Environment Configuration

# Application Settings
APP_NAME=Land Scanner Prototype
APP_VERSION=1.0.0
DEBUG=false

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Data Provider Settings
OSM_BUILDINGS_ENABLED=true
OSM_BUILDINGS_TIMEOUT=10

ADMIN_BOUNDARIES_ENABLED=true
ADMIN_BOUNDARIES_TIMEOUT=10

LAND_COVER_ENABLED=true
LAND_COVER_TIMEOUT=10

OSM_ROADS_ENABLED=true
OSM_ROADS_TIMEOUT=10

OSM_WATER_ENABLED=true
OSM_WATER_TIMEOUT=10

ELEVATION_ENABLED=true
ELEVATION_TIMEOUT=10

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs/

# Frontend
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
