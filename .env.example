# Land Scanner Environment Variables

# Environment
ENVIRONMENT=development

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Data Providers
OVERPASS_API_ENDPOINT=http://overpass-api.de/api/interpreter
COPERNICUS_STAC_ENDPOINT=https://services.sentinel-hub.com/api/v1/
USGS_ELEVATION_ENDPOINT=https://epqs.nationalmap.gov/v1/json

# Logging
LOG_LEVEL=INFO
